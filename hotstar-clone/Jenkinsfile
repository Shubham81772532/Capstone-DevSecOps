// Hotstar Clone — CI/CD Pipeline
// Jenkins does CI (build, test, scan, push image, update Helm values).
// ArgoCD watches the Git repo and does CD (deploys to Kubernetes) on its own.

pipeline {

    agent any

    tools {
        nodejs 'nodejs'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 45, unit: 'MINUTES')
    }

    environment {
        APP_DIR     = 'hotstar-clone'
        HELM_DIR    = 'hotstar-clone/helm'
        IMAGE_NAME  = 'shubhamnavale8177/hotstar'
        IMAGE_TAG   = "${BUILD_NUMBER}"
        AWS_REGION  = 'us-east-1'
        EKS_CLUSTER = 'hotstar-eks'
    }

    triggers {
        githubPush()
    }

    stages {

        // ---------- PHASE 1: BUILD & TEST ----------

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                dir(env.APP_DIR) {
                    sh 'npm ci'
                }
            }
        }

        stage('Build React App') {
            steps {
                dir(env.APP_DIR) {
                    sh 'CI=false npm run build'
                }
            }
        }

        stage('Unit Tests') {
            steps {
                dir(env.APP_DIR) {
                    sh 'CI=true npm test -- --watchAll=false --passWithNoTests'
                }
            }
        }

        // ---------- PHASE 2: SECURE ----------

        stage('SonarQube Scan') {
            steps {
                script {
                    def scannerHome = tool 'sonar-scanner'
                    withSonarQubeEnv('sonarqube') {
                        sh "${scannerHome}/bin/sonar-scanner -Dsonar.projectKey=hotstar -Dsonar.sources=${APP_DIR}/src"
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Trivy FS Scan') {
            steps {
                sh """
                    mkdir -p trivy-reports
                    trivy fs --severity CRITICAL,HIGH -o trivy-reports/fs-report.txt ${APP_DIR}
                """
            }
            post {
                always {
                    archiveArtifacts artifacts: 'trivy-reports/fs-report.txt', allowEmptyArchive: true
                }
            }
        }

        stage('Docker Build') {
            steps {
                sh "docker build -f ${APP_DIR}/Dockerfile -t ${IMAGE_NAME}:${IMAGE_TAG} ${APP_DIR}/"
            }
        }

        stage('Trivy Image Scan') {
            steps {
                sh """
                    mkdir -p trivy-reports
                    trivy image --severity CRITICAL,HIGH -o trivy-reports/image-report.txt ${IMAGE_NAME}:${IMAGE_TAG}
                """
            }
            post {
                always {
                    archiveArtifacts artifacts: 'trivy-reports/image-report.txt', allowEmptyArchive: true
                }
            }
        }

        stage('OWASP ZAP Scan') {
            steps {
                sh """
                    docker run -d --name zap-target -p 8090:80 ${IMAGE_NAME}:${IMAGE_TAG}
                    sleep 15
                    mkdir -p ${WORKSPACE}/zap-reports
                    chmod 777 ${WORKSPACE}/zap-reports
                    docker run --rm --network host -v ${WORKSPACE}/zap-reports:/zap/wrk \
                      ghcr.io/zaproxy/zaproxy:stable zap-baseline.py -t http://localhost:8090 -r zap-report.html -I
                """
            }
            post {
                always {
                    sh 'docker stop zap-target || true'
                    sh 'docker rm zap-target || true'
                    publishHTML(target: [
                        allowMissing: true,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: 'zap-reports',
                        reportFiles: 'zap-report.html',
                        reportName: 'OWASP ZAP Report'
                    ])
                }
            }
        }

        // ---------- PHASE 3: SHIP ----------

        stage('Docker Push') {
            steps {
                retry(2) {
                    withCredentials([usernamePassword(credentialsId: 'dockerhub-creds', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                        sh '''
                            echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin
                            docker push ${IMAGE_NAME}:${IMAGE_TAG}
                            docker tag  ${IMAGE_NAME}:${IMAGE_TAG} ${IMAGE_NAME}:latest
                            docker push ${IMAGE_NAME}:latest
                            docker logout
                        '''
                    }
                }
            }
        }

        stage('Update Helm & Push to Git') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'github-creds', usernameVariable: 'GIT_USER', passwordVariable: 'GIT_TOKEN')]) {
                    // yq edits the YAML structurally instead of text-replacing a line,
                    // so it can't accidentally corrupt values.yaml's formatting.
                    sh """
                        yq -i '.image.tag = "${IMAGE_TAG}"' ${HELM_DIR}/values.yaml
                        git config user.email "jenkins-bot@hotstar.local"
                        git config user.name "jenkins-bot"
                        git add ${HELM_DIR}/values.yaml
                        git commit -m "Update image tag to ${IMAGE_TAG} [skip ci]" || echo "Nothing to commit"
                    """
                    // fetch + rebase first in case another build pushed to main
                    // in between our checkout and now
                    retry(3) {
                        sh """
                            git fetch origin main
                            git rebase origin/main
                            git push https://\$GIT_USER:\$GIT_TOKEN@github.com/Shubham81772532/Capstone-DevSecOps.git HEAD:main
                        """
                    }
                }
            }
        }

        // ---------- PHASE 4: DEPLOY (ArgoCD does the actual deploy) ----------

        stage('Verify Deployment') {
            steps {
                withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-creds']]) {
                    sh 'aws eks update-kubeconfig --region ${AWS_REGION} --name ${EKS_CLUSTER}'
                }
                sh '''
                    echo "Waiting for ArgoCD to pick up the change..."
                    sleep 60
                    kubectl rollout status deployment/hotstar -n default --timeout=120s
                    kubectl get pods -n default
                '''
            }
        }

        stage('Cleanup') {
            steps {
                sh '''
                    docker rmi ${IMAGE_NAME}:${IMAGE_TAG} || true
                    docker rmi ${IMAGE_NAME}:${IMAGE_TAG} || true
                    docker rmi ${IMAGE_NAME}:latest || true
                    docker image prune -f
                '''
            }
        }
    }

    post {
        success {
            echo "Pipeline succeeded — ${IMAGE_NAME}:${IMAGE_TAG} deployed via ArgoCD."
        }
        failure {
            echo "Pipeline failed — check the console log above."
        }
        always {
            cleanWs()
        }
    }
}